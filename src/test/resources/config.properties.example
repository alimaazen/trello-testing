# Trello Test Configuration - EXAMPLE FILE
# Copy this file to config.properties and configure your settings
# OR use environment variables (recommended for credentials)

# Trello Application URL
trello.url=https://trello.com/login

# Test Account Credentials
# OPTION 1 (Recommended): Set as environment variables
#   TRELLO_EMAIL and TRELLO_PASSWORD (use setup-env.bat)
#   These are read automatically by the framework.
#
# OPTION 2: Set directly in config.properties (NOT recommended for git)
#   Uncomment and fill in your credentials below
# trello.email=your_email@example.com
# trello.password=your_password

# Second Trello account - required only for the Collaboration module (invites,
# roles, assigning members, @mentions, watch notifications). This account must
# already be a member of the same Workspace as the primary account above -
# add it once manually via Workspace > Members. Board-level invites between
# two existing Workspace members then complete instantly, with no email
# confirmation step, which is what makes them automatable.
# OPTION 1 (Recommended): TRELLO_EMAIL_SECOND / TRELLO_PASSWORD_SECOND env vars
# OPTION 2: uncomment below
# trello.email.second=your_second_email@example.com
# trello.password.second=your_second_password

# Browser Configuration
# browser: firefox (default) | chrome | edge
# headless: true | false (default false)
browser=firefox
headless=false
