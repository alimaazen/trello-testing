# Trello Test Configuration - EXAMPLE FILE
# Copy this file to config.properties and configure your settings
# OR use environment variables (recommended for credentials)

# Trello Application URL
trello.url=https://trello.com/login

# Test Account Credentials
# OPTION 1 (Recommended): Set as environment variables
#   TRELLO_EMAIL and TRELLO_PASSWORD (use setup-env.bat)
#   These are read automatically by the framework.
#
# OPTION 2: Set directly in config.properties (NOT recommended for git)
#   Uncomment and fill in your credentials below
# trello.email=your_email@example.com
# trello.password=your_password

# Browser Configuration
# browser: firefox (default) | chrome | edge
# headless: true | false (default false)
browser=firefox
headless=false
